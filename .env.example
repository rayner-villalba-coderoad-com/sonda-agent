# Copia este archivo como .env y pon tu clave de la API de Anthropic.
# Consíguela en https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Modelo a usar (ver modelos disponibles en https://docs.claude.com)
ANTHROPIC_MODEL=claude-sonnet-5-5

# Máximo de tokens por respuesta
MAX_TOKENS=4096

# Puerto e interfaz. Deja 127.0.0.1 para que solo tu equipo acceda.
PORT=3000
HOST=127.0.0.1
